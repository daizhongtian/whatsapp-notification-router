# Offline mode is deterministic and requires no credentials.

# Optional OpenAI-compatible Agent API. Never commit a real key.
AI_API_KEY=
AI_API_BASE_URL=http://127.0.0.1:4310/v1
AI_API_MODEL=gpt-5.6-sol
AI_API_ALLOW_REMOTE=0
AI_API_TIMEOUT_SECONDS=60
AI_API_MAX_RETRIES=2
AI_API_RETRY_BACKOFF_SECONDS=0.25
AI_API_CONCURRENCY=4
AI_API_BATCH_SIZE=8
AI_API_REQUESTS_PER_SECOND=4
AI_API_MAX_NETWORK_REQUESTS=512
AI_API_MAX_OUTPUT_TOKENS=4096
AI_API_MIN_SUCCESS_RATIO=0.95
AI_API_HYBRID_CONFIDENCE_THRESHOLD=0.68
AI_API_CACHE_TTL_SECONDS=300
AI_API_MAX_CACHE_ENTRIES=128

# Optional persistent content-fact cache. Leave blank for privacy. If enabled,
# this directory contains OCR/transcript text but never keys or user profiles.
ROUTER_CACHE_DIR=

# Optional local faster-whisper configuration for voice notes.
ROUTER_WHISPER_MODEL=small
ROUTER_WHISPER_DOWNLOAD_ROOT=
ROUTER_ASR_DEVICE=cpu
ROUTER_ASR_COMPUTE_TYPE=int8
ROUTER_ENABLE_LOCAL_ASR=1
ROUTER_WHISPER_LOCAL_FILES_ONLY=1
